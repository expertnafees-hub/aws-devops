{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "AWS Infrastructure for Nafees Ur Rehman DevOps Portfolio. Creates S3 SPA bucket, CloudFront CDN with OAC, and GitHub Actions OIDC IAM Role.",
  "Parameters": {
    "GitHubRepo": {
      "Type": "String",
      "Default": "expertnafees-hub/aws-devops",
      "Description": "GitHub owner and repository name for OIDC subject condition (format owner/repo)"
    },
    "EnvironmentName": {
      "Type": "String",
      "Default": "production",
      "Description": "Environment name tag"
    },
    "AlertEmail": {
      "Type": "String",
      "Default": "expertnafees@gmail.com",
      "Description": "Email address to receive CloudWatch downtime and error rate alerts"
    },
    "EnableWAF": {
      "Type": "String",
      "Default": "true",
      "AllowedValues": [
        "true",
        "false"
      ],
      "Description": "Toggle AWS WAF v2 WebACL edge protection on CloudFront distribution for FinOps cost control"
    }
  },
  "Conditions": {
    "CreateWAFResources": {
      "Fn::Equals": [
        {
          "Ref": "EnableWAF"
        },
        "true"
      ]
    }
  },
  "Resources": {
    "GitHubActionsOIDCProvider": {
      "Type": "AWS::IAM::OIDCProvider",
      "Properties": {
        "Url": "https://token.actions.githubusercontent.com",
        "ClientIdList": [
          "sts.amazonaws.com"
        ],
        "ThumbprintList": [
          "06d927fecd0a84aeba28aad1d808139470fe95c3",
          "2d74d6dfd96eea55ad7baafa0d3c6552b2dadc37",
          "ab9d0263244dd0326eb67015705a667e79cfe998",
          "6938fd4d98bab03faadb97b34396831e3780aea1",
          "1c58a3a8518e8759bf075b76b750d4f8d264fcd9"
        ]
      }
    },
    "WebsiteBucket": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "BucketName": {
          "Fn::Sub": "nafees-portfolio-spa-${AWS::AccountId}"
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "DevOpsPortfolio"
          },
          {
            "Key": "Environment",
            "Value": {
              "Ref": "EnvironmentName"
            }
          }
        ]
      }
    },
    "CloudFrontOAC": {
      "Type": "AWS::CloudFront::OriginAccessControl",
      "Properties": {
        "OriginAccessControlConfig": {
          "Name": {
            "Fn::Sub": "${AWS::StackName}-s3-oac"
          },
          "Description": "Origin Access Control for Private S3 Website Origin",
          "OriginAccessControlOriginType": "s3",
          "SigningBehavior": "always",
          "SigningProtocol": "sigv4"
        }
      }
    },
    "CloudFrontWebACL": {
      "Type": "AWS::WAFv2::WebACL",
      "Condition": "CreateWAFResources",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-cloudfront-waf"
        },
        "Description": "Edge WAF v2 protection for CloudFront distribution - Rate Limiting and AWS Common Rule Set",
        "Scope": "CLOUDFRONT",
        "DefaultAction": {
          "Allow": {}
        },
        "VisibilityConfig": {
          "SampledRequestsEnabled": true,
          "CloudWatchMetricsEnabled": true,
          "MetricName": "CloudFrontWebACLMetric"
        },
        "Rules": [
          {
            "Name": "RateLimit300RequestsPer5Minutes",
            "Priority": 1,
            "Action": {
              "Block": {}
            },
            "Statement": {
              "RateBasedStatement": {
                "Limit": 300,
                "AggregateKeyType": "IP"
              }
            },
            "VisibilityConfig": {
              "SampledRequestsEnabled": true,
              "CloudWatchMetricsEnabled": true,
              "MetricName": "RateLimit300RequestsPer5MinutesMetric"
            }
          },
          {
            "Name": "AWSManagedRulesCommonRuleSet",
            "Priority": 2,
            "OverrideAction": {
              "None": {}
            },
            "Statement": {
              "ManagedRuleGroupStatement": {
                "VendorName": "AWS",
                "Name": "AWSManagedRulesCommonRuleSet"
              }
            },
            "VisibilityConfig": {
              "SampledRequestsEnabled": true,
              "CloudWatchMetricsEnabled": true,
              "MetricName": "AWSManagedRulesCommonRuleSetMetric"
            }
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "DevOpsPortfolio"
          },
          {
            "Key": "Environment",
            "Value": {
              "Ref": "EnvironmentName"
            }
          }
        ]
      }
    },
    "CloudFrontDistribution": {
      "Type": "AWS::CloudFront::Distribution",
      "Properties": {
        "DistributionConfig": {
          "Enabled": true,
          "Comment": {
            "Fn::Sub": "Production CDN for ${GitHubRepo}"
          },
          "DefaultRootObject": "index.html",
          "HttpVersion": "http2and3",
          "PriceClass": "PriceClass_100",
          "WebACLId": {
            "Fn::If": [
              "CreateWAFResources",
              {
                "Fn::GetAtt": [
                  "CloudFrontWebACL",
                  "Arn"
                ]
              },
              {
                "Ref": "AWS::NoValue"
              }
            ]
          },
          "Origins": [
            {
              "DomainName": {
                "Fn::GetAtt": [
                  "WebsiteBucket",
                  "RegionalDomainName"
                ]
              },
              "Id": "S3Origin",
              "OriginAccessControlId": {
                "Fn::GetAtt": [
                  "CloudFrontOAC",
                  "Id"
                ]
              },
              "S3OriginConfig": {
                "OriginAccessIdentity": ""
              }
            }
          ],
          "DefaultCacheBehavior": {
            "TargetOriginId": "S3Origin",
            "ViewerProtocolPolicy": "redirect-to-https",
            "AllowedMethods": [
              "GET",
              "HEAD",
              "OPTIONS"
            ],
            "CachedMethods": [
              "GET",
              "HEAD"
            ],
            "Compress": true,
            "ForwardedValues": {
              "QueryString": false,
              "Cookies": {
                "Forward": "none"
              }
            },
            "MinTTL": 0,
            "DefaultTTL": 86400,
            "MaxTTL": 31536000
          },
          "CustomErrorResponses": [
            {
              "ErrorCode": 403,
              "ResponseCode": 200,
              "ResponsePagePath": "/index.html",
              "ErrorCachingMinTTL": 10
            },
            {
              "ErrorCode": 404,
              "ResponseCode": 200,
              "ResponsePagePath": "/index.html",
              "ErrorCachingMinTTL": 10
            }
          ]
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "DevOpsPortfolio"
          },
          {
            "Key": "Environment",
            "Value": {
              "Ref": "EnvironmentName"
            }
          }
        ]
      }
    },
    "WebsiteBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "WebsiteBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "AllowCloudFrontServicePrincipalReadOnly",
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudfront.amazonaws.com"
              },
              "Action": "s3:GetObject",
              "Resource": {
                "Fn::Sub": "${WebsiteBucket.Arn}/*"
              },
              "Condition": {
                "StringEquals": {
                  "AWS:SourceArn": {
                    "Fn::Sub": "arn:aws:cloudfront::${AWS::AccountId}:distribution/${CloudFrontDistribution}"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "GitHubDeployRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "GitHubActions-Deploy-DevOpsPortfolio",
        "Description": "Allows GitHub Actions runner to sync S3 and invalidate CloudFront via OIDC",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Federated": {
                  "Fn::GetAtt": [
                    "GitHubActionsOIDCProvider",
                    "Arn"
                  ]
                }
              },
              "Action": "sts:AssumeRoleWithWebIdentity",
              "Condition": {
                "StringEquals": {
                  "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
                  "token.actions.githubusercontent.com:repository": "expertnafees-hub/aws-devops"
                },
                "StringLike": {
                  "token.actions.githubusercontent.com:sub": [
                    "repo:expertnafees-hub/aws-devops:*",
                    "repo:expertnafees-hub@*/aws-devops@*:*"
                  ]
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "S3AndCloudFrontDeploymentPolicy",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "S3SyncPermissions",
                  "Effect": "Allow",
                  "Action": [
                    "s3:PutObject",
                    "s3:GetObject",
                    "s3:ListBucket",
                    "s3:DeleteObject"
                  ],
                  "Resource": [
                    {
                      "Fn::GetAtt": [
                        "WebsiteBucket",
                        "Arn"
                      ]
                    },
                    {
                      "Fn::Sub": "${WebsiteBucket.Arn}/*"
                    }
                  ]
                },
                {
                  "Sid": "CloudFrontInvalidatePermissions",
                  "Effect": "Allow",
                  "Action": [
                    "cloudfront:CreateInvalidation",
                    "cloudfront:GetInvalidation",
                    "cloudfront:GetDistribution"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:aws:cloudfront::${AWS::AccountId}:distribution/${CloudFrontDistribution}"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "DevOpsAlertsSNSTopic": {
      "Type": "AWS::SNS::Topic",
      "Properties": {
        "TopicName": {
          "Fn::Sub": "${AWS::StackName}-alerts"
        },
        "DisplayName": "DevOps Portfolio SRE Alerts"
      }
    },
    "DevOpsAlertsSubscription": {
      "Type": "AWS::SNS::Subscription",
      "Properties": {
        "TopicArn": {
          "Ref": "DevOpsAlertsSNSTopic"
        },
        "Protocol": "email",
        "Endpoint": {
          "Ref": "AlertEmail"
        }
      }
    },
    "CloudFront5xxAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmName": {
          "Fn::Sub": "${AWS::StackName}-5xx-error-rate-alarm"
        },
        "AlarmDescription": "Trigger alert if CloudFront 5xx error rate exceeds 1% in a 5-minute window",
        "Namespace": "AWS/CloudFront",
        "MetricName": "5xxErrorRate",
        "Dimensions": [
          {
            "Name": "DistributionId",
            "Value": {
              "Ref": "CloudFrontDistribution"
            }
          },
          {
            "Name": "Region",
            "Value": "Global"
          }
        ],
        "Statistic": "Average",
        "Period": 300,
        "EvaluationPeriods": 1,
        "Threshold": 1.0,
        "ComparisonOperator": "GreaterThanThreshold",
        "TreatMissingData": "notBreaching",
        "AlarmActions": [
          {
            "Ref": "DevOpsAlertsSNSTopic"
          }
        ],
        "OKActions": [
          {
            "Ref": "DevOpsAlertsSNSTopic"
          }
        ]
      }
    }
  },
  "Outputs": {
    "AwsOidcRoleArn": {
      "Description": "IAM Role ARN to configure in GitHub Secret AWS_OIDC_ROLE_ARN",
      "Value": {
        "Fn::GetAtt": [
          "GitHubDeployRole",
          "Arn"
        ]
      }
    },
    "AwsS3Bucket": {
      "Description": "S3 Bucket name to configure in GitHub Secret AWS_S3_BUCKET",
      "Value": {
        "Ref": "WebsiteBucket"
      }
    },
    "AwsCloudfrontDistributionId": {
      "Description": "CloudFront Distribution ID to configure in GitHub Secret AWS_CLOUDFRONT_DISTRIBUTION_ID",
      "Value": {
        "Ref": "CloudFrontDistribution"
      }
    },
    "LiveWebsiteUrl": {
      "Description": "Your live portfolio URL (CloudFront Edge)",
      "Value": {
        "Fn::Sub": "https://${CloudFrontDistribution.DomainName}"
      }
    },
    "SnsTopicArn": {
      "Description": "SNS Topic ARN for CloudWatch SRE Alerts",
      "Value": {
        "Ref": "DevOpsAlertsSNSTopic"
      }
    },
    "WebACLArn": {
      "Condition": "CreateWAFResources",
      "Description": "ARN of the AWS WAF v2 WebACL associated with CloudFront",
      "Value": {
        "Fn::GetAtt": [
          "CloudFrontWebACL",
          "Arn"
        ]
      }
    },
    "WebACLId": {
      "Condition": "CreateWAFResources",
      "Description": "ID of the AWS WAF v2 WebACL associated with CloudFront",
      "Value": {
        "Fn::GetAtt": [
          "CloudFrontWebACL",
          "Id"
        ]
      }
    }
  }
}
